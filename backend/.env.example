# SQLite (Local default fallback)
# DATABASE_URL=sqlite:///./foresight.db

# Supabase PostgreSQL Database Connection String
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Connection Pooling)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Comma-separated origins allowed to call the API from browsers
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
